# -----------------------------------------------------------------------------
# Navin Backend — environment template (alphabetized)
# See docs/environment-variables.md for the full implemented-vs-required matrix.
# -----------------------------------------------------------------------------

# Comma-separated browser origins allowed by CORS (empty = none beyond defaults)
ALLOWED_ORIGINS=http://localhost:3000

# Legacy single CORS origin fallback (* = allow all)
CORS_ORIGIN=*

# Deployed frontend base URL (invite + password-reset links)
FRONTEND_URL=http://localhost:5173

# JWT signing secret (required, min 32 characters)
JWT_SECRET=replace-this-with-a-strong-32-char-minimum-jwt-secret

# Pino log level (optional; not validated in env.ts) — debug|info|warn|error
LOG_LEVEL=debug

# MongoDB connection string (required)
MONGO_URI=mongodb://127.0.0.1:27017/navin_dev

# Runtime mode: development | test | production
NODE_ENV=development

# HTTP listen port
PORT=3000

# Redis URL for BullMQ, SSE, and caches
REDIS_URL=redis://127.0.0.1:6379

# --- SendGrid (optional email relay; preferred over raw SMTP when set) ---
SENDGRID_API_KEY=

# --- Sentry (optional; validated but SDK not wired yet — TODO) ---
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# --- SMTP (optional email — used by src/services/email.service.ts) ---
SMTP_FROM=noreply@example.com
SMTP_HOST=smtp.example.com
SMTP_PASS=smtp-password
SMTP_PORT=587
SMTP_USER=you@example.com

# --- S3 object storage (optional — TODO wire real adapter; see #379) ---
S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
S3_BUCKET=my-bucket
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# --- Soroban / escrow (optional — TODO implement client; see #358) ---
ESCROW_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2B
SOROBAN_RPC_URL=https://soroban-rpc.example.com

# --- Stellar ---
# Network: testnet | public
STELLAR_NETWORK=testnet
# Horizon signing secret (required for anchoring jobs)
STELLAR_SECRET_KEY=SAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# HMAC secret for /api/webhooks/stellar (min 16 chars)
STELLAR_WEBHOOK_SECRET=replace-this-with-a-strong-random-secret

# --- Twilio SMS (optional — TODO SMS OTP client; see #364) ---
TWILIO_FROM=+15551234567
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your-twilio-auth-token
